FROM python:3.12-alpine

LABEL org.opencontainers.image.title="careconnect-service" \
      org.opencontainers.image.description="CareConnect demo microservice"

ARG APP_VERSION=1.0.0
ENV SERVICE_NAME=careconnect-service \
    APP_VERSION=${APP_VERSION} \
    PYTHONUNBUFFERED=1

WORKDIR /app

# dependencies first -> this layer is cached until requirements.txt changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# code last -> changes often, only this layer rebuilds
COPY app.py .

# run as non-root (numeric UID so Kubernetes runAsNonRoot can verify it)
RUN adduser -D -u 10001 appuser
USER 10001

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

ENTRYPOINT ["python"]
CMD ["app.py"]
