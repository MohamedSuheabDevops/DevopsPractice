FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/app .

# scratch = empty image. Only the static binary ships.
FROM scratch
COPY --from=build /out/app /app
USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["/app"]
